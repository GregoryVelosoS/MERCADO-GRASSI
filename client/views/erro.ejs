<!-- IMPORTAR O HEADER -->
<%- include('partials/header') %> 

<main class="flex-grow-1">
    <h1>OPS, ALGO DEU ERRADO </h1>
    <!-- MOSTRA A MENSAGEM DE ERRO -->
    <p class="fs-2 bold">
        <%= mensagem %>
    </p>

    <!-- MOSTRA O ERRO, SE HOUVER -->
    <% if (typeof erro !== 'undefined' && erro) { %>
        <p class="fs-2 bold">
            <%= erro %>
        </p>
    <% } %>

</main>
<!-- IMPORTAR O FOOTER -->
<%- include('partials/footer') %> 